# Copy to .env and edit values for your machine.

# Optional: enable reverse DNS in event attribution (0/1)
IPS_ENABLE_REVERSE_DNS=0

# Enable actual host-side enforcement (0/1)
IPS_ENFORCEMENT_ENABLED=1

# Temporary block duration when action is drop_packet
IPS_DROP_TTL_SEC=120

# Longer block duration when action is block_ip
IPS_BLOCK_TTL_SEC=3600
